# Copy privately to .env.production or use PROD_ENV_FILE=/secure/path/veea.env.
# Do not reuse local keys. Generate each value independently with openssl rand -hex 32.
# All DB passwords must be hex (inserted into container-internal PostgreSQL URLs).
VEEA_PROD_IMAGE=
VEEA_PROD_DB_ADMIN_PASSWORD=
VEEA_PROD_MIGRATION_PASSWORD=
VEEA_PROD_API_PASSWORD=
VEEA_PROD_MAINTENANCE_PASSWORD=
VEEA_EMAIL_HMAC_KEY=
VEEA_OTP_KEY=
# Format: 1:<64 hex characters>; preserve all needed previous key versions.
VEEA_OUTBOX_KEY=
# Bare address on a Resend-verified domain, e.g. hello@bluleap.ai.
VEEA_EMAIL_FROM=
VEEA_RESEND_API_KEY=
# Loopback ports for the host TLS reverse proxy/internal Prometheus.
VEEA_PROD_HTTP_PORT=28386
VEEA_PROD_METRICS_PORT=29090
VEEA_TRUSTED_PROXIES=

VEEA_APPLE_IAP_ENABLED=false
VEEA_APPLE_IAP_ALLOW_SANDBOX=false
VEEA_APPLE_IAP_ENVIRONMENT=
VEEA_APPLE_IAP_ISSUER_ID=
VEEA_APPLE_IAP_KEY_ID=
VEEA_APPLE_IAP_PRIVATE_KEY=
VEEA_APPLE_IAP_PRIVATE_KEY_FILE=
VEEA_APPLE_IAP_BUNDLE_ID=
VEEA_APPLE_IAP_PRODUCT_IDS=
VEEA_APPLE_IAP_KEY_HOST_FILE=
