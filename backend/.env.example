# Local Compose only. Copy to .env (gitignored), then generate independent throwaway
# values using the README. Empty values deliberately prevent startup.
# Database password must be URL-safe hex because Compose inserts it in the local URL.
VEEA_LOCAL_DB_PASSWORD=
# Each HMAC/OTP key: openssl rand -hex 32 (current[,previous], at least 32 bytes).
VEEA_EMAIL_HMAC_KEY=
VEEA_OTP_KEY=
# Outbox: 1:<openssl rand -hex 32> (id:hex[,id:hex], exactly 32 bytes per key).
VEEA_OUTBOX_KEY=

# Every published port binds only to 127.0.0.1. These differ from the test scripts'
# PostgreSQL (54329) and Mailpit (1025/8025) ports. Change if already occupied.
VEEA_GO_HTTP_PORT=18386
VEEA_GO_DB_PORT=54328
VEEA_GO_METRICS_PORT=19090
VEEA_GO_SMTP_PORT=1026
VEEA_GO_MAILPIT_PORT=8026

# Current Compose selects Resend. Supply these privately before config/startup.
# For automated local-only SMTP checks, use make test-flutter-go instead.
VEEA_EMAIL_FROM=
VEEA_RESEND_API_KEY=
# Keep .env and existing keys across down/up to decrypt durable OTP/outbox data.
# Recovery CLI keys require separate independent custody; never reuse these keys for it.
